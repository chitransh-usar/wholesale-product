# Public API origin. This value is embedded in the browser build.
VITE_API_BASE_URL=https://your-backend-domain.example

# Cloudinary identifiers used for browser uploads. Configure upload restrictions
# in Cloudinary; do not put private API secrets in VITE_ variables.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
