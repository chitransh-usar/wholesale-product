# Required
# External database URLs must verify TLS. For Render's internal URL, omit
# sslmode unless you also supply the provider's trusted CA in DATABASE_SSL_CA.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=verify-full
JWT_SECRET=replace-with-a-long-random-secret
# Optional PEM CA certificate for a remote PostgreSQL provider.
DATABASE_SSL_CA=

# Server settings
PORT=5000
JWT_EXPIRES_IN=30d
CLIENT_URL=https://your-frontend-domain.example

# Optional integrations. Leave blank until configured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE=https://api.razorpay.com

EMAIL_PROVIDER=smtp
EMAIL_FROM=
EMAIL_FROM_NAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=

SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

WHATSAPP_PROVIDER=twilio
TWILIO_WHATSAPP_FROM=

FCM_SERVICE_ACCOUNT_JSON=
GEOCODER_USER_AGENT=
CHALLAN_WHEN_UNPAID=false
